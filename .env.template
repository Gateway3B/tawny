# Tawny connects to the SurrealDB container published by Compose for local
# development. Override this endpoint only when using another deployment.
SURREALDB_HOST=ws://127.0.0.1:8001
SURREALDB_PORT=8001
SURREALDB_NAMESPACE=tawny
SURREALDB_NAME=main
SURREALDB_USER=root
SURREALDB_PASSWORD=root
SURREALDB_VERSION=3.2.4
SURREALDB_MEMORY_LIMIT=2g

# Optional rustypipe-botguard executable. Enables PO-token-backed streams on
# YouTube client types that require BotGuard. Session PO tokens are cached.
# TAWNY_BOTGUARD_BIN=/path/to/rustypipe-botguard

# `docker compose up -d` publishes the containerized yt-dlp API here for a
# host `dx serve`. yt-dlp, Node, its plugin, and the PO provider are installed
# only in containers. Production Tawny uses the internal `http://yt-dlp:8080`.
TAWNY_YTDLP_SERVICE_URL=http://127.0.0.1:8090
YTDLP_SERVICE_PORT=8090
POT_PROVIDER_PORT=4416
YTDLP_CONCURRENCY=2
YTDLP_VERSION=2026.8.19
POT_PROVIDER_VERSION=2.0.0

# Optional legacy mode without the yt-dlp sidecar. Leave both unset when using
# Compose. Tawny only searches PATH when TAWNY_YTDLP_SERVICE_URL is absent.
# TAWNY_YTDLP_BIN=/path/to/yt-dlp
# TAWNY_PO_TOKEN_PROVIDER_URL=http://127.0.0.1:4416

# Public HTTPS origin and optional explicit callback URL for YouTube WebSub.
# WebSub remains disabled on localhost; polling and manual refresh still work.
TAWNY_PUBLIC_URL=http://127.0.0.1:8080
# TAWNY_WEBSUB_CALLBACK_URL=https://tawny.example/api/v1/websub/youtube

# Persist this in deployment secrets. If omitted, Tawny generates and stores a
# random secret in its data directory, which under Docker means the volume
# TAWNY_APP_VOLUME points at.
TAWNY_WEBSUB_SECRET=

# Production profile host port. Development dx serve remains on 8080.
TAWNY_PORT=8080

# Used by packaged desktop/mobile clients to reach the Tawny server.
SERVER_URL=http://127.0.0.1:8080

# Where the Compose stack keeps its two data volumes, on the host. A bare name
# is a Docker named volume, which Docker places under /var/lib/docker/volumes.
# An absolute path is a bind mount instead, which is what you want when the
# stack directory is managed for you, as it is under Portainer, or when the
# data belongs on a specific disk. Both default to the named volumes, so
# leaving these unset keeps the existing behaviour.
TAWNY_SURREALDB_VOLUME=surrealdb-data
TAWNY_APP_VOLUME=tawny-data

# Set only behind a trusted proxy that overwrites this client-address header.
CLIENT_IP_HEADER=
