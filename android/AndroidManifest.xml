<?xml version="1.0" encoding="utf-8"?>
<!--
Merged by Gradle into the manifest dx generates (`[android] manifest` in
Dioxus.toml).

Phones stay in portrait. g3-ui picks its layout by width, so a phone turned
sideways got the tablet layout with little height left for content. dx's
MainActivity drops this lock on screens 600dp and wider, as Android 16 does,
so tablets and unfolded foldables still rotate.

The intent filters let YouTube links open in Tawny (src/youtube_links.rs).
Tawny cannot verify youtube.com, so Android leaves tapped links with the
YouTube app or the browser until the viewer turns on "Open supported links"
for Tawny in its app settings. Share works without that: "Share" in YouTube or
a chat app lists Tawny for any text, and Tawny finds the link in it.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <activity android:name="dev.dioxus.main.MainActivity" android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:scheme="http" />
                <data android:host="youtube.com" />
                <data android:host="www.youtube.com" />
                <data android:host="m.youtube.com" />
                <data android:host="music.youtube.com" />
                <data android:host="youtu.be" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
    </application>
</manifest>
