{
  "name": "tawny-player-transport",
  "private": true,
  "version": "0.1.0",
  "description": "Vendored browser transport runtime for Tawny's Dioxus player",
  "scripts": {
    "test": "npm run test:unit",
    "test:all": "npm run test:unit && npm run test:rust && npm run test:ui",
    "test:unit": "npm run test:unit:js && npm run test:unit:extractor",
    "test:unit:js": "node --check assets/tawny_player_controls.js && node --test tests/tawny_transport.test.cjs tests/tawny_player_timeline.test.cjs",
    "test:unit:extractor": "node --test docker/extractor/server.test.mjs",
    "test:rust": "npm run test:rust:web && npm run test:rust:server",
    "test:rust:web": "cargo test",
    "test:rust:server": "cargo test --no-default-features --features server",
    "test:ui": "playwright test",
    "test:ui:mobile": "playwright test --project mobile-chromium",
    "test:ui:desktop": "playwright test --project desktop-chromium",
    "test:ui:headed": "playwright test --headed",
    "test:ui:report": "playwright show-report",
    "format:web": "biome format --write .",
    "format:web:check": "biome format .",
    "lint:web": "biome lint ."
  },
  "dependencies": {
    "shaka-player": "4.16.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@playwright/test": "^1.56.1",
    "ws": "8.21.0"
  }
}
