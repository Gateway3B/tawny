# Copy this to .env.prod on the deploy host only, or paste these as the stack's
# environment variables in Portainer. Never commit the filled-in copy.
#
# Only what compose.prod.yml actually reads is listed here. The development
# .env.template carries host-only settings that a container ignores.

# Pin to sha-<commit> to hold a known-good build; latest follows main.
TAWNY_IMAGE_TAG=latest

# No default on purpose: a deployed database with the password "root" is worse
# than a stack that refuses to start.
SURREALDB_PASSWORD=
SURREALDB_USER=root
SURREALDB_NAMESPACE=tawny
SURREALDB_NAME=main
SURREALDB_VERSION=3.2.4
SURREALDB_MEMORY_LIMIT=2g

# No default on purpose. The origin browsers reach this instance on, and what
# playback proxy URLs and WebSub lease callbacks are built from, so a wrong
# value surfaces as broken playback rather than as a configuration error. Must
# be the public HTTPS origin: WebSub stays disabled on a loopback URL.
TAWNY_PUBLIC_URL=

# Set only when YouTube should call back somewhere other than the public URL,
# such as a second hostname that bypasses a bot-filtering CDN.
TAWNY_WEBSUB_CALLBACK_URL=

# Left empty, Tawny generates one and keeps it on the app volume. That is fine
# only as long as that volume survives: replace the volume and every existing
# subscription fails its signature check until it renews. Set it explicitly if
# the data may ever move.
TAWNY_WEBSUB_SECRET=

# Host port for Tawny. It is the only published port; the database and the
# sidecars are reachable only inside the stack.
TAWNY_PORT=8080

# Simultaneous stream extractions.
YTDLP_CONCURRENCY=2
POT_PROVIDER_VERSION=2.0.0

# Where the stack keeps its two data volumes, on the host. A bare name is a
# Docker named volume, which Docker places under /var/lib/docker/volumes. An
# absolute path is a bind mount instead, which is what you want when the stack
# directory is managed for you, as it is under Portainer, or when the data
# belongs on a specific disk.
TAWNY_SURREALDB_VOLUME=surrealdb-data
TAWNY_APP_VOLUME=tawny-data

# Optional. Put Tawny on a reverse proxy's existing Docker network so the proxy
# can reach it as `tawny:8080`, which also lets you stop publishing TAWNY_PORT.
# Both move together: naming an existing network without setting EXTERNAL=true
# makes Compose try to create it and fail. Leave unset and the stack owns an
# ordinary network of its own, needing no proxy setup at all.
# TAWNY_PROXY_NETWORK=npm_default
# TAWNY_PROXY_NETWORK_EXTERNAL=true

# Set only behind a trusted proxy that overwrites this client-address header.
CLIENT_IP_HEADER=
